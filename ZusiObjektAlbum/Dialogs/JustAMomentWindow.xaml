<Window x:Class="ZusiObjektAlbum.Dialogs.JustAMomentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiObjektAlbum.Dialogs"
        x:Name="window"
        mc:Ignorable="d" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Title="Zusi • Objektalbum" SizeToContent="WidthAndHeight" Background="{x:Null}" WindowStartupLocation="CenterOwner">
    <Grid>
        <Border Background="CornflowerBlue" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6,6,0,0">
            <DockPanel>
                <TextBlock Foreground="WhiteSmoke" DockPanel.Dock="Top" Text="{Binding Title, ElementName=window}" Margin="6,2" VerticalAlignment="Top"/>
                <Border Background="{x:Static SystemColors.ControlBrush}" BorderBrush="Black" BorderThickness="1 0 1 1">
                    <StackPanel>
                        <TextBlock Text="Ich lade gerade ein paar tausend Zusi-3D-Objekte." HorizontalAlignment="Center" Margin="24,12,24,3"/>
                        <TextBlock Text="Bitte einen kleinen Augenblick Geduld." HorizontalAlignment="Center" Margin="0,3,0,12"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
