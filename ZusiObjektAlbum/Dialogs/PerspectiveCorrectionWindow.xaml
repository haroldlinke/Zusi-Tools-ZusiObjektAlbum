<Window x:Class="ZusiObjektAlbum.Dialogs.PerspectiveCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perspektive korrigieren" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Klicke nacheinander die 4 Ecken eines eigentlich rechteckigen Merkmals an (z.B. Fensterrahmen oder Gebäudekante): oben-links, oben-rechts, unten-rechts, unten-links."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Zurücksetzen" Click="ResetButton_Click" Padding="10,4" Margin="0,0,6,0"/>
      <Button x:Name="ApplyButton" Content="Anwenden" IsEnabled="False" Click="ApplyButton_Click" Padding="10,4" Margin="0,0,6,0"/>
      <Button Content="Abbrechen" IsCancel="True" Padding="10,4"/>
    </StackPanel>

    <Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1">
      <Viewbox Stretch="Uniform">
        <Canvas x:Name="ImageCanvas" MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown">
          <Image x:Name="PhotoImage"/>
        </Canvas>
      </Viewbox>
    </Border>
  </DockPanel>
</Window>