<Window x:Class="ZusiObjektAlbum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiObjektAlbum"
        xmlns:c="clr-namespace:ZusiObjektAlbum.Controls"
        xmlns:cv="clr-namespace:ZusiObjektAlbum.Converter"
        xmlns:m="clr-namespace:ZusiObjektAlbum.Miscellaneous"
        xmlns:mvvm="clr-namespace:ZusiObjektAlbum.MVVM"
        xmlns:sck="clr-namespace:Sovoma.ControlsKit;assembly=Sovoma.ControlsKit"
        xmlns:sl="clr-namespace:SovomaLib;assembly=SovomaLib"
        xmlns:t="clr-namespace:WPFTreeViewLib;assembly=WPFTreeViewLib"
        xmlns:v="clr-namespace:ZusiObjektAlbum.ValidationRules"
        Background="#FFA59E9E"
        mc:Ignorable="d"
        x:Name="window"
        DataContext="{Binding Source={x:Static mvvm:DataManager.Instance}}"
        Title="Zusi • Objektalbum" Height="1080" Width="1920" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <cv:WarningLevelConverter x:Key="WarningLevelConverter"/>
    <cv:NotEmptyStringConverter x:Key="NotEmptyStringConverter"/>

    <SolidColorBrush x:Key="OptionButton.Background.On" Color="OrangeRed"/>

    <!-- textbox error style -->
    <Style x:Key="TextBoxErrorStyle" TargetType="{x:Type TextBox}">
      <Setter Property="Validation.ErrorTemplate">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="Red" BorderThickness="1">
              <AdornedElementPlaceholder/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="True">
          <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <ContextMenu x:Key="CopyObjektPathContextMenu">
      <MenuItem Command="{x:Static m:ZOACommands.CopyPathToClipboardCommand}"/>
    </ContextMenu>
  </Window.Resources>

  <DockPanel>
    <Menu VerticalAlignment="Center"  Padding="0,0" Visibility="Visible" DockPanel.Dock="Top">
      <Control.Background>

        <LinearGradientBrush>
          <GradientStop Offset="0" Color="#FF76A8FF"/>
          <GradientStop Offset="1" Color="#FF6A9BF3"/>
        </LinearGradientBrush>
      </Control.Background>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="MenuItemOptions" Command="{x:Static local:MainWindow.CommandIndexObjects}" />
        <MenuItem Header="Modell von GitHub herunterladen..." Click="OnDownloadModel"/>
        <MenuItem Header="Index von GitHub herunterladen..." Click="OnDownloadIndex"/>
      </MenuItem>
    </Menu>

    <!-- StatusBar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" >
                    <Run Text="Anzahl der Objekte:"/>
                    <Run Text="{Binding NumberOfObjects, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
          <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
          </TextBlock>
          <Button x:Name="btnCancelIndexing" Content="Abbrechen" Margin="8,0,0,0" Padding="6,1"
                Visibility="Collapsed" Click="BtnCancelIndexing_Click"/>
        </StackPanel>
      </StatusBarItem>
      <StatusBarItem Margin="12 0 0 0">
        <TextBlock VerticalAlignment="Center" Text="{Binding SelectedObject.WarningLevel, Converter={StaticResource WarningLevelConverter}}">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedObject.WarningLevel}" Value="1">
                  <Setter Property="Foreground" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedObject.WarningLevel}" Value="2">
                  <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock>
                        <Run Text="Version"/>
                        <Run Text="{Binding ConverterParameter=%V, Converter={StaticResource VersionStringConverter}, Source={x:Static sl:AsmInfo.Version}, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock>
                        <Run Text=" •"/>
                        <Run Text="{Binding Source={x:Static sl:AsmInfo.Copyright}, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>
    <!-- main area -->
    <Grid Margin="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="15*"/>
        <ColumnDefinition Width="20*"/>
        <ColumnDefinition Width="65*"/>
      </Grid.ColumnDefinitions>
      <Rectangle x:Name="rctMask" Fill="Black" Opacity="0.66" IsHitTestVisible="False" Panel.ZIndex="10" Visibility="{Binding IsLoadData, Converter={StaticResource BoolToVisibilityConverter}}" Grid.ColumnSpan="3" Margin="-5" d:IsHidden="True"/>
      <!-- treeview of objects -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="0,1,0,0" Background="{x:Null}" BorderThickness="0">
          <TabItem Header="Objektübersicht">
            <c:DisplayControl Title="Objektübersicht" Margin="0 0 0 1">
              <TreeView x:Name="tvObjects" BorderThickness="0" ItemsSource="{Binding Objects, Mode=OneWay}" Background="{x:Null}" SelectedItemChanged="ObjectView_SelectedItemChanged" t:TreeViewInPlaceEditBehavior.IsEditable="True">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <!-- Drag'n'Drop
                            <EventSetter Event="DragOver" Handler="ObjectView_DragOver"/>
                            <EventSetter Event="Drop" Handler="ObjectView_Drop"/>
                            <EventSetter Event="MouseMove" Handler="ObjectView_MouseMove"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ObjectView_PreviewMouseLeftButtonDown"/>
                            -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ObjectView_PreviewMouseRightButtonDown"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBold}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsBold}" Value="False">
                        <Setter Property="FontWeight" Value="Normal"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsErroneous}" Value="True">
                        <Setter Property="FontStyle" Value="Italic"/>
                        <Setter Property="Foreground" Value="Red"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=OneWay}">
                    <Grid>
                      <TextBlock Text="{Binding DisplayName}" Margin="2"/>
                      <TextBox x:Name="edit" Text="{Binding DisplayName, UpdateSourceTrigger=Explicit}" Visibility="Collapsed"/>
                    </Grid>
                    <HierarchicalDataTemplate.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSelected}" Value="True"/>
                          <Condition Binding="{Binding IsReadOnly}" Value="False"/>
                          <Condition Binding="{Binding Path=(t:TreeViewInPlaceEditBehavior.IsEditing), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeView}}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="edit" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="edit" Property="t:TreeViewInPlaceEditBoxBehavior.IsEditing">
                          <Setter.Value>
                            <Binding Path="(t:TreeViewInPlaceEditBehavior.IsEditing)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeView}}"/>
                          </Setter.Value>
                        </Setter>
                        <Setter TargetName="edit" Property="t:TreeViewInPlaceEditBoxBehavior.IsEditConfirmed">
                          <Setter.Value>
                            <Binding Path="(t:TreeViewInPlaceEditBehavior.IsEditConfirmed)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeView}}"/>
                          </Setter.Value>
                        </Setter>
                        <Setter TargetName="edit" Property="t:TreeViewInPlaceEditBoxBehavior.IsEditCancelled">
                          <Setter.Value>
                            <Binding Path="(t:TreeViewInPlaceEditBehavior.IsEditCancelled)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeView}}"/>
                          </Setter.Value>
                        </Setter>
                      </MultiDataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </c:DisplayControl>
          </TabItem>
          <TabItem Header="Suche">
            <c:MainView/>
          </TabItem>
        </TabControl>
        <c:DisplayControl Grid.Row="3" Title="Eigene Objekte verwalten" CanExpand="True" Margin="0 1 0 0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Neuer Abschnitt" Style="{StaticResource PropertyNameStyle}"/>
            <TextBox x:Name="tbxNewSection2" Grid.Column="1" BorderThickness="0" Margin="0 0 0 1" Padding="3,2,0,0" Style="{StaticResource TextBoxErrorStyle}">
              <TextBox.Text>
                <Binding Path="NewSection2" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <v:ValidateSectionName/>
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Text="Ordner" Grid.Row="1" Style="{StaticResource PropertyNameStyle}"/>
            <sck:FileSelector Grid.Column="1" Grid.Row="1" Margin="0,0,0,1" IsFolderPicker="True" BorderThickness="0" SelectedFullPath="{Binding ObjectFolder, Mode=TwoWay}" Padding="5,0,3,0" VerticalAlignment="Stretch"/>
            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="6" LastChildFill="False">
              <Button Command="m:ZOACommands.ManageFoldersCommand" CommandTarget="{Binding ElementName=window}" Style="{StaticResource CommandButtonStyle}" Margin="0 0 3 0"/>
              <Button DockPanel.Dock="Right" Command="m:ZOACommands.ImportFolderCommand" CommandTarget="{Binding ElementName=window}" Style="{StaticResource CommandButtonStyle}"/>
            </DockPanel>
          </Grid>
        </c:DisplayControl>
      </Grid>
      <GridSplitter HorizontalAlignment="Left" Width="5" Grid.Column="1" Background="#00FFFFFF"/>
      <!-- properties / actions -->
      <Grid Grid.Column="1" Margin="5,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- properties -->
        <c:DisplayControl Grid.Row="1" Title="Objekteigenschaften" Margin="0,0,0,1">
          <c:ObjectPropertiesViewer DataContext="{Binding SelectedObject, Mode=OneWay}" Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"/>
        </c:DisplayControl>
        <!-- object explorer options -->

        <c:DisplayControl Grid.Row="2" Title="Optionen der Objektanzeige" CanExpand="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="96"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hintergrund" Style="{StaticResource PropertyNameStyle}"/>
            <Border Grid.Column="1" Margin="0 0 0 1" Background="{x:Static SystemColors.WindowBrush}">
              <sck:OptionButton OffText="hell" OnText="dunkel" VerticalAlignment="Center" IsChecked="{Binding IsDarkObjectViewBackground, Mode=TwoWay}" Margin="5,0,3,0"/>
            </Border>
            <TextBlock Grid.Row="1" Text="Bodenplatte" Style="{StaticResource PropertyNameStyle}"/>
            <Border Grid.Row="1" Grid.Column="1" Margin="0 0 0 1" Background="{x:Static SystemColors.WindowBrush}">
              <sck:OptionButton VerticalAlignment="Center" IsChecked="{Binding HasGroundplate, Mode=TwoWay}" Margin="5,0,3,0"/>
            </Border>
          </Grid>
        </c:DisplayControl>
        <!-- actions -->
        <c:DisplayControl Grid.Row="3" Title="Objekt importieren" Margin="0,1" CanExpand="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Neuer Abschnitt" Style="{StaticResource PropertyNameStyle}"/>
            <TextBox x:Name="tbxNewSection1" Grid.Column="1" BorderThickness="0" Margin="0 0 0 1" Padding="3,2,0,0" Style="{StaticResource TextBoxErrorStyle}">
              <TextBox.Text>
                <Binding Path="NewSection1" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <v:ValidateSectionName/>
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Text="Objektdatei" Grid.Row="1" Style="{StaticResource PropertyNameStyle}"/>
            <sck:FileSelector Grid.Column="1" Grid.Row="1" Margin="0 0 0 1" BorderThickness="0" SelectedFullPath="{Binding ObjectFile, Mode=TwoWay}" VerticalAlignment="Stretch" Padding="5,0,3,0" 
                                          Filter="Zusi-3D-Objekt|*.lod.ls3|Alle Dateien|*.*"/>
            <TextBlock Text="Objekt merken" Grid.Row="2" Style="{StaticResource PropertyNameStyle}"/>
            <Border Grid.Row="2" Grid.Column="1" Margin="0 0 0 1" Background="{x:Static SystemColors.WindowBrush}">
              <sck:OptionButton VerticalAlignment="Center" IsChecked="{Binding KeepInMindFile, Mode=TwoWay}" Padding="1" Margin="5,0,3,0"/>
            </Border>
            <Button Command="m:ZOACommands.ImportObjectCommand" CommandTarget="{Binding ElementName=window}" Style="{StaticResource CommandButtonStyle}"
                                Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,6,6,6"/>
          </Grid>
        </c:DisplayControl>
        <c:DisplayControl Grid.Row="4" Title="Dateipfade exportieren" Margin="0,1,0,0" CanExpand="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dateiname" Style="{StaticResource PropertyNameStyle}"/>
            <sck:FileSelector Grid.Column="1" Margin="0,0,0,1" BorderThickness="0" Padding="5,0,3,0" VerticalAlignment="Stretch" SelectedFullPath="{Binding ExportFile.Filename, Mode=TwoWay}"
                                          IsEnabled="{Binding ExportFile.IsActive, Converter={StaticResource ReverseBoolConverter}}" Filter="Textdateien|*.txt|Alle Dateien|*.*"/>
            <!--
                        <TextBlock Text="Datei sichtbar" Grid.Row="1" Style="{StaticResource PropertyNameStyle}"/>
                        <Border Grid.Row="1" Grid.Column="1" Margin="0 0 0 1" Background="{x:Static SystemColors.WindowBrush}">
                            <sck:OptionButton VerticalAlignment="Center" IsChecked="{Binding ExportFile.IsTopmost, Mode=TwoWay}" Margin="5,0,0,0"
                                              IsEnabled="{Binding ExportFile.Filename, Converter={StaticResource NotEmptyStringConverter}, Mode=OneWay}"/>
                        </Border>
                        -->
            <TextBlock Text="Export aktiv" Grid.Row="2" Style="{StaticResource PropertyNameStyle}"/>
            <Border Grid.Row="2" Grid.Column="1" Margin="0 0 0 1" Background="{x:Static SystemColors.WindowBrush}">
              <sck:OptionButton VerticalAlignment="Center" IsChecked="{Binding ExportFile.IsActive, Mode=TwoWay}" Margin="5,0,3,0"
                                              IsEnabled="{Binding ExportFile.Filename, Converter={StaticResource NotEmptyStringConverter}, Mode=OneWay}"/>
            </Border>
            <Button Command="m:ZOACommands.ClearExportFileCommand" CommandTarget="{Binding ElementName=window}" Style="{StaticResource CommandButtonStyle}"
                                Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,6,6,6"/>
          </Grid>
        </c:DisplayControl>
      </Grid>
      <GridSplitter HorizontalAlignment="Left" Width="5" Grid.Column="2" Background="#00FFFFFF"/>
      <!-- object views -->
      
      <Grid DataContext="{Binding SelectedObject, Mode=OneWay}" Grid.Column="2" Margin="5,0,0,0" 
            MouseLeftButtonDown="ResultItemBorder_MouseLeftButtonDown"
MouseMove="ResultItemBorder_MouseMove"
            
            >
        <Grid.RowDefinitions>
          <RowDefinition Height="1*"/>
          <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <c:ObjectViewControl Title="linke Seite" Camera="{Binding Cameras[0]}" Model="{Binding Model}" Transform="{Binding Transform}" Margin="0,0,1,0" 
                                         Background="{Binding ObjectViewBackground, Source={x:Static mvvm:DataManager.Instance}}"
                                         ContextMenu="{StaticResource CopyObjektPathContextMenu}"/>
          <c:ObjectViewControl Title="Rückseite" Camera="{Binding Cameras[2]}" Model="{Binding Model}" Transform="{Binding Transform}" Grid.Column="1" Margin="1,0" 
                                         Background="{Binding ObjectViewBackground, Source={x:Static mvvm:DataManager.Instance}}"
                                         ContextMenu="{StaticResource CopyObjektPathContextMenu}"/>
          <c:ObjectViewControl Title="rechte Seite" Camera="{Binding Cameras[1]}" Model="{Binding Model}" Transform="{Binding Transform}" Grid.Column="2" Margin="1,0,0,0" 
                                         Background="{Binding ObjectViewBackground, Source={x:Static mvvm:DataManager.Instance}}"
                                         ContextMenu="{StaticResource CopyObjektPathContextMenu}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,1,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="0.5*"/>
          </Grid.ColumnDefinitions>
          <c:ObjectViewControl Title="Vorderseite" Camera="{Binding Cameras[3]}" Model="{Binding Model}" Transform="{Binding Transform}" Margin="0,0,1,0" 
                                         Background="{Binding ObjectViewBackground, Source={x:Static mvvm:DataManager.Instance}}"
                                         ContextMenu="{StaticResource CopyObjektPathContextMenu}"/>
          <c:ObjectViewControl x:Name="panoramaView" Title="Rundumsicht" Camera="{Binding Cameras[4]}" Model="{Binding Model}" Transform="{Binding Transform}" Grid.Column="1" Margin="1,0,0,0" IsAnimated="True" 
                                         Background="{Binding ObjectViewBackground, Source={x:Static mvvm:DataManager.Instance}}"
                                         ContextMenu="{StaticResource CopyObjektPathContextMenu}"/>
          <!--<c:MainView Grid.Column="1" Grid.Row="1"/>-->
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
