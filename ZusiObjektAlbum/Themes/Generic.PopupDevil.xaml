<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ZusiObjektAlbum.Controls">

    <Style TargetType="{x:Type local:PopupDevil}">
        <Setter Property="Background" Value="Blue"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0 0 6 0"/>
        <Setter Property="Margin" Value="0 0 0 1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PopupDevil}">
                    <Border Background="{x:Static SystemColors.WindowBrush}">
                        <Grid HorizontalAlignment="Right" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Ellipse Width="15" Height="15" Fill="{TemplateBinding Background}"/>
                            <TextBlock Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="I" Foreground="{TemplateBinding Foreground}" FontSize="10" FontFamily="Times New Roman"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>