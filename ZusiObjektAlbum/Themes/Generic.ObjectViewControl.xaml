<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ZusiObjektAlbum.Controls"
                    xmlns:sck="clr-namespace:Sovoma.ControlsKit;assembly=Sovoma.ControlsKit">

    <Storyboard x:Key="CameraRotation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="RotationAngleZ" To="360" Duration="0:0:10"/>
    </Storyboard>
    
    <Style TargetType="{x:Type local:ObjectViewControl}">
        <Setter Property="TitleBackground" Value="{DynamicResource Caption.Background}"/>
        <Setter Property="Background" Value="AliceBlue"/>
        <Setter Property="Foreground" Value="GhostWhite"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ObjectViewControl}">
                    <Border CornerRadius="6,6,0,0" Background="{TemplateBinding TitleBackground}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <sck:OptionButton DockPanel.Dock="Right" OnText="" Margin="0 0 6 0" IsChecked="{Binding IsAnimationActive, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Visibility="{Binding IsAnimated, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{TemplateBinding Title}" Margin="6,1,3,1" VerticalAlignment="Top" Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <!--
                                <Slider x:Name="PART_Slider" Margin="24,1,12,1" 
                                        Visibility="{Binding ShowVelocitySlider, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}, Mode=OneWay}"
                                        Value="{Binding GoAroundTime, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Maximum="20" IsDirectionReversed="True"/>
                                -->
                            </DockPanel>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}">
                                <Viewport3D>
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera FieldOfView="92" 
                                                           Position="{Binding Camera.Position, RelativeSource={RelativeSource TemplatedParent}}" 
                                                           LookDirection="{Binding Camera.LookDirection, RelativeSource={RelativeSource TemplatedParent}}" 
                                                           UpDirection="{Binding Camera.UpDirection, RelativeSource={RelativeSource TemplatedParent}}">
                                            <PerspectiveCamera.Transform>
                                                <Transform3DGroup>
                                                    <RotateTransform3D>
                                                        <RotateTransform3D.Rotation>
                                                            <AxisAngleRotation3D Axis="0,0,1" Angle="{Binding RotationAngleZ, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        </RotateTransform3D.Rotation>
                                                    </RotateTransform3D>
                                                    <RotateTransform3D>
                                                        <RotateTransform3D.Rotation>
                                                            <AxisAngleRotation3D Axis="0,1,0" Angle="{Binding RotationAngleY, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        </RotateTransform3D.Rotation>
                                                    </RotateTransform3D>
                                                </Transform3DGroup>
                                            </PerspectiveCamera.Transform>
                                        </PerspectiveCamera>
                                    </Viewport3D.Camera>
                                    <Viewport3D.Children>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <AmbientLight Color="{Binding AmbientLight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                        <ModelVisual3D Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}" Transform="{Binding Transform, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Viewport3D.Children>
                                </Viewport3D>
                            </Border>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>