<UserControl x:Class="ZusiObjektAlbum.Controls.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZusiObjektAlbum.Controls"
             xmlns:cv="clr-namespace:ZusiObjektAlbum.Converter"
             Background="White">

  <!--Background="#1e1e1e">-->

  <UserControl.Resources>
    <cv:ObjectPreviewImageConverter x:Key="ObjectPreviewImageConverter"/>

    <!--<SolidColorBrush x:Key="PanelBrush" Color="#2b2b2b" />-->
    <SolidColorBrush x:Key="PanelBrush" Color="White" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3a8ee6" />

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#555" />
          <Setter Property="Foreground" Value="#999" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="BorderBrush" Value="Black" />
      <Setter Property="Padding" Value="5" />
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="Black" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>-->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== Linke Spalte ===================== -->
    <StackPanel Grid.Row="0">

      <TextBlock Text="Foto des realen Objekts" FontWeight="Bold" FontSize="14" Margin="0,24,0,8" />

      <!-- Drag & Drop-Bereich -->
      <Border x:Name="DropArea"
                    Height="230"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#555" BorderThickness="2"
                    CornerRadius="6"
                    AllowDrop="True"
                    Drop="DropArea_Drop"
                    DragOver="DropArea_DragOver"
                    MouseLeftButtonUp="DropArea_MouseLeftButtonUp"
                    Cursor="Hand">
        <Grid>
          <TextBlock x:Name="DropHintText"
                               Text="Foto hier ablegen&#x0a;oder klicken zum Auswählen"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#888" />
          <Image x:Name="PhotoPreviewImage"
                           Stretch="Uniform"
                           Margin="8"
                           Visibility="Collapsed" />
        </Grid>
      </Border>

      <Button x:Name="SearchButton"
                    Content="Ähnliche Objekte suchen"
                    Margin="0,14,0,0"
                    IsEnabled="False"
                    Click="SearchButton_Click" />

      <ProgressBar x:Name="ProgressIndicator"
                         IsIndeterminate="True"
                         Height="4"
                         Margin="0,14,0,0"
                         Visibility="Collapsed" />

      <TextBlock x:Name="StatusText"
                       Text="Bereit."
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="#aaa"
                       TextWrapping="Wrap" />
    </StackPanel>

    <!-- ===================== Rechte Spalte: Ergebnisse ===================== -->
    <DockPanel Grid.Row="1">

      <TextBlock DockPanel.Dock="Top"
                       Text="Ergebnisse"
                       FontWeight="Bold" FontSize="14"
                       Margin="0,0,0,8" />

      <ListBox x:Name="ResultsList"
                     Background="DarkGray"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="On_ResultsList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="6"
                                Margin="0,0,4,10"
                                Padding="10"
                    MouseLeftButtonDown="ResultItemBorder_MouseLeftButtonDown"
                    MouseMove="ResultItemBorder_MouseMove">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                                        Width="80" Height="80"
                                        Background="Black"
                                        CornerRadius="4">
                  <!--<Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImageConverter}}"
                                           Stretch="Uniform" />-->
                  <Image Stretch="Uniform">
                    <Image.Source>
                      <MultiBinding Converter="{StaticResource ObjectPreviewImageConverter}">
                        <Binding Path="SourcePath"/>
                        <Binding Path="BestView"/>
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ObjectId, StringFormat='Objekt {0}'}"
                                               FontWeight="Bold" FontSize="15" />
                  <TextBlock Text="{Binding ScoreDisplay}"
                                               FontSize="12" Foreground="Black" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding ViewDisplay}"
                                               FontSize="11" Foreground="Black" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding SourcePath}"
                                               FontSize="10" Foreground="Black" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourcePath}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
