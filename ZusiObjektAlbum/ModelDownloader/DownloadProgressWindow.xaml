<Window x:Class="ZusiObjektAlbum.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download" Height="150" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="Lade herunter..." Margin="0,0,0,8"/>
        <ProgressBar x:Name="ProgressBarControl" Minimum="0" Maximum="100" Height="18"/>
        <Button x:Name="CancelButton" Content="Abbrechen" Margin="0,12,0,0"
                HorizontalAlignment="Right" Padding="10,3" Click="CancelButton_Click"/>
    </StackPanel>
</Window>
